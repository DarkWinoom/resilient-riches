{
  "name": "resilient-riches",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.22.2 <23",
    "pnpm": ">=11.19.0 <12"
  },
  "scripts": {
    "dev": "pnpm build:core && pnpm -r --parallel --if-present dev",
    "build:core": "pnpm --filter @resilient-riches/core build",
    "build": "pnpm -r build",
    "start": "node apps/server/dist/start.js",
    "db:migrate": "node apps/server/dist/migrate.js",
    "typecheck": "pnpm build:core && pnpm -r typecheck && tsc -p tsconfig.tests.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build:core && vitest run",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.2",
    "eslint": "10.10.0",
    "eslint-plugin-vue": "10.11.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
